# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ENABLE_LLM_REPORT=true
ENABLE_RAG=false

# ── 데이터 경로 ───────────────────────────────────────────────────────────────
DATA_DIR=./data
DUCKDB_PATH=./data/app.duckdb

# ── 서비스 설정 ───────────────────────────────────────────────────────────────
DEFAULT_REGION=서울
DEFAULT_YEAR_QUARTER=20244
FRONTEND_API_BASE_URL=http://localhost:3288

# ── 지도 / 외부 검색 (카카오 디벨로퍼스) ──────────────────────────────────────
# https://developers.kakao.com/console/app
#  - JavaScript 키 → KAKAO_JAVA_SCRIPT_KEY (브라우저에서 maps SDK 로드용. 앱 키 ≠ REST 키)
#  - REST API 키    → KAKAO_REST_API_KEY (서버 사이드 /api/external-search 등)
# (호환) 예전 이름 KAKAO_MAP_APP_KEY 도 JavaScript 키로 인식합니다.
# MAP_PROVIDER: auto(키 있으면 카카오맵 시도, 실패 시 Leaflet) | kakao | leaflet
MAP_PROVIDER=auto
KAKAO_JAVA_SCRIPT_KEY=
KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID=

# ── 경영위험 점수 가중치 ──────────────────────────────────────────────────────
RISK_SCORE_WEIGHT_SALES=0.25
RISK_SCORE_WEIGHT_COMPETITION=0.20
RISK_SCORE_WEIGHT_CLOSURE=0.15
RISK_SCORE_WEIGHT_POPULATION=0.15
RISK_SCORE_WEIGHT_SURVIVAL=0.15
RISK_SCORE_WEIGHT_RENT=0.10
